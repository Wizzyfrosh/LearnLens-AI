{
  "name": "learnlens-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty",
    "preview": "vite preview",
    "test": "vitest run src",
    "verify:extension": "node scripts/verify-extension-build.mjs",
    "poc:app-check:typecheck": "tsc --project poc/app-check-extension/tsconfig.json --pretty",
    "poc:app-check:build": "vite build --config poc/app-check-extension/vite.config.ts",
    "poc:app-check:verify": "npm run poc:app-check:typecheck && npm run poc:app-check:build && node scripts/verify-app-check-poc.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-learnlens-rules \"node --test tests/firestore.rules.test.mjs\"",
    "test:functions": "firebase emulators:exec --only firestore --project demo-learnlens-functions \"npm --prefix functions test\"",
    "poc:turnstile-hosted:typecheck": "tsc --project poc/turnstile-hosted/tsconfig.json --pretty",
    "poc:turnstile-hosted:test": "vitest run poc/turnstile-hosted/src/protocol.test.ts",
    "poc:turnstile-hosted:build": "vite build --config poc/turnstile-hosted/vite.config.ts",
    "poc:turnstile-hosted:verify": "npm run poc:turnstile-hosted:typecheck && npm run poc:turnstile-hosted:test && npm run poc:turnstile-hosted:build && node scripts/verify-turnstile-hosted.mjs"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.1.35",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.0",
    "@types/node": "^22.15.30",
    "fake-indexeddb": "^6.2.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^15.37.0"
  }
}
