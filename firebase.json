{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    }
  },
  "functions": {
    "source": "functions",
    "codebase": "learnlens",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      ".env",
      ".env.*",
      "firebase-debug.log",
      "firebase-debug.*",
      "*.local"
    ]
  }
}
